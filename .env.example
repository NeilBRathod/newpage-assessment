# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# `make install` does this for you.

# ---- Database (the only containerised service) ----
# Host port is 5433 so a local Postgres on 5432 keeps working.
POSTGRES_USER=meetingiq
POSTGRES_PASSWORD=meetingiq
POSTGRES_DB=meetingiq
POSTGRES_HOST_PORT=5433
MEETINGIQ_DATABASE_URL=postgresql+psycopg://meetingiq:meetingiq@localhost:5433/meetingiq

# ---- Model provider ----
# "ollama" (default, runs on the host) | "openai" (optional cloud fallback) | "fake" (tests)
MEETINGIQ_PROVIDER=ollama

# Ollama runs natively on the host so it can use the GPU — Docker on macOS
# cannot reach Metal. Running the API in a container instead (`make docker-up`)
# overrides this to http://host.docker.internal:11434.
MEETINGIQ_OLLAMA_BASE_URL=http://localhost:11434
MEETINGIQ_GENERATION_MODEL=gemma4:12b
MEETINGIQ_EMBEDDING_MODEL=embeddinggemma:300m
MEETINGIQ_EMBEDDING_DIMENSIONS=768

# Ollama silently defaults num_ctx to 2048 regardless of the model's real
# window, which truncates retrieved context and produces ungrounded answers.
# It is sent explicitly on every request and asserted at startup.
MEETINGIQ_NUM_CTX=32768

# Gemma 4 reasons before answering. Measured 3x slower with no quality gain on
# grounded QA — see docs/MEASUREMENTS.md.
MEETINGIQ_ENABLE_THINKING=false

# ---- Optional cloud fallback (only read when MEETINGIQ_PROVIDER=openai) ----
# OPENAI_API_KEY=
# MEETINGIQ_OPENAI_GENERATION_MODEL=gpt-5-mini
# MEETINGIQ_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- App ----
MEETINGIQ_LOG_LEVEL=INFO
MEETINGIQ_API_HOST_PORT=8000

# The web dev server refuses to start if this port is taken, rather than
# silently drifting to another one and then failing CORS. If 5173 is busy, set
# both of these to the same new port.
VITE_PORT=5173
MEETINGIQ_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
